  <!-- QML loads the render assets from disk, next to the .exe -->
  <Target Name="CopyAssets" AfterTargets="Build">
    <ItemGroup>
      <AssetFiles Include="$(MSBuildProjectDirectory)\assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="@(AssetFiles->'$(OutDir)assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- QML code completion (qmlls in Visual Studio): describes the C++ types and the wayfare.presentation module.
       Writes obj\qml\wayfare\presentation (qmldir + presentation.qmltypes) and .qmlls.ini, which needs an absolute path. -->
  <Target Name="GenerateQmlTooling" AfterTargets="Build">
    <PropertyGroup>
      <QmlToolingImportDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\obj\qml'))</QmlToolingImportDir>
      <QmlToolingModuleDir>$(QmlToolingImportDir)\wayfare\presentation\</QmlToolingModuleDir>
      <QmlToolingWorkDir>$(IntDir)qmltooling\</QmlToolingWorkDir>
      <QmlToolingMetatypes>$(QmlToolingWorkDir)presentation_metatypes.json</QmlToolingMetatypes>
    </PropertyGroup>
    <MakeDir Directories="$(QmlToolingModuleDir);$(QmlToolingWorkDir)" />
    <Exec Command="&quot;$(QtInstallDir)\bin\moc.exe&quot; -I&quot;$(QtInstallDir)\include&quot; -I&quot;$(QtInstallDir)\include\QtCore&quot; -I&quot;$(QtInstallDir)\include\QtQml&quot; --output-json &quot;%(QtMoc.FullPath)&quot; -o &quot;$(QmlToolingWorkDir)%(QtMoc.Filename).moc.cpp&quot;" />
    <Exec Command="&quot;$(QtInstallDir)\bin\moc.exe&quot; --collect-json @(QtMoc->'&quot;$(QmlToolingWorkDir)%(Filename).moc.cpp.json&quot;', ' ') -o &quot;$(QmlToolingMetatypes)&quot;" />
    <Exec Command="&quot;$(QtInstallDir)\bin\qmltyperegistrar.exe&quot; --import-name wayfare.presentation --major-version 1 --minor-version 0 --foreign-types &quot;$(QtInstallDir)\metatypes\qt6core_metatypes.json,$(QtInstallDir)\metatypes\qt6qml_metatypes.json&quot; --generate-qmltypes &quot;$(QmlToolingModuleDir)presentation.qmltypes&quot; -o &quot;$(QmlToolingWorkDir)presentation_qmltyperegistrations.cpp&quot; &quot;$(QmlToolingMetatypes)&quot;" />
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\qml\qmldir">
      <Output TaskParameter="Lines" ItemName="QmlToolingQmldirLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <QmlToolingLine Include="$([System.String]::Copy('%(QmlToolingQmldirLine.Identity)').Replace(' 1.0 ', ' 1.0 ../../../../WayFare.Presentation/qml/'))" />
      <QmlToolingLine Include="typeinfo presentation.qmltypes" />
    </ItemGroup>
    <WriteLinesToFile File="$(QmlToolingModuleDir)qmldir" Lines="@(QmlToolingLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\..\.qmlls.ini" Lines="[General];importPaths=$(QmlToolingImportDir.Replace('\', '/'));no-cmake-calls=true" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
